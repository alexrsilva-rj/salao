# ============================================================
# Variáveis de ambiente para desenvolvimento local
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no repositório
# ============================================================

# PostgreSQL
POSTGRES_DB=salao_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# Keycloak Admin (acesso ao console de administração)
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# API Token Secret — string criptograficamente segura (min 32 chars)
# Gere com: openssl rand -hex 32
API_TOKEN_SECRET=
